<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="431.0" prefWidth="395.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KalkulatorController">
   <children>
     <Label text="Kalkulator BMI">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
       <VBox spacing="5.0">
         <children>
            <Label text="Berat Badan (kg):" />
            <TextField fx:id="inputBerat" promptText="Contoh: 65" />
         </children>
      </VBox>
      
       <VBox spacing="5.0">
         <children>
            <Label text="Tinggi Badan (cm):" />
            <TextField fx:id="inputTinggi" promptText="Contoh: 170" />
         </children>
      </VBox>
      
       <Button mnemonicParsing="false" onAction="#hitungBMI" prefHeight="30.0" prefWidth="200.0" text="Hitung BMI" />
      
         <Label fx:id="labelHasil" alignment="CENTER" prefHeight="92.0" prefWidth="234.0" text="Hasil akan muncul di sini" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
